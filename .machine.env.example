# 复制为 .machine.env 后填写。只放证书名、钥匙串档案名和本地路径。
# 同名环境变量优先。

# 证书名或 SHA-1，用 security find-identity -v -p codesigning 查看。
# 留空或填 - 时以 ad-hoc 签名，供本机开发使用。
SNUG_RUSTDESK_SIGNING_IDENTITY=

# dist / ship 需要 Developer ID Application 证书和公证档案。
# 用 xcrun notarytool store-credentials 建好专用于本项目的钥匙串档案后填写。
SNUG_RUSTDESK_NOTARY_PROFILE=

# 为本项目配置好证书、公证档案和 GitHub 发布后设为 1。
# 此开关同时启用 dist、ship 和新构建的应用内更新。
SNUG_RUSTDESK_ENABLE_RELEASE=0

# 可选。使用指定的 gh 配置目录和账号发布。
GH_CONFIG_DIR=
SNUG_RUSTDESK_GITHUB_ACCOUNT=
